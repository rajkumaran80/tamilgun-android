data class Movie(val title: String, val thumbUrl: String, val detailUrl: String)
data class PlayerSource(val name: String, val url: String)

sealed class Screen {
    object Grid : Screen()
    data class PlayerSelection(val movie: Movie) : Screen()
    data class VideoPlayer(val url: String, val movie: Movie) : Screen()
}

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent {
            var currentScreen by remember { mutableStateOf<Screen>(Screen.Grid) }
            var lastPage by remember { mutableStateOf(1) }
            var lastSelectedMovie by remember { mutableStateOf<Movie?>(null) }

            BackHandler(enabled = currentScreen !is Screen.Grid) {
                currentScreen = when (val screen = currentScreen) {
                    is Screen.VideoPlayer -> Screen.PlayerSelection(screen.movie)
                    is Screen.PlayerSelection -> Screen.Grid
                    else -> Screen.Grid
                }
            }

            MaterialTheme {
                Surface(modifier = Modifier.fillMaxSize(), color = Color(0xFF121212)) {
                    when (val screen = currentScreen) {
                        is Screen.Grid -> MovieGridScreen(
                            initialPage = lastPage,
                            initialSelectedMovie = lastSelectedMovie,
                            onMovieClick = { movie, page ->
                                lastSelectedMovie = movie
                                lastPage = page
                                if (movie?.detailUrl?.isNotEmpty() == true) {
                                    currentScreen = Screen.PlayerSelection(movie)
                                }
                            }
                        )
                        is Screen.PlayerSelection -> PlayerSelectionScreen(screen.movie) { url ->
                            currentScreen = Screen.VideoPlayer(url, screen.movie)
                        }
                        is Screen.VideoPlayer -> FullScreenPlayer(screen.url)
                    }
                }
            }
        }
    }
}

@Composable
fun MovieGridScreen(
    initialPage: Int,
    initialSelectedMovie: Movie?,
    onMovieClick: (Movie?, Int) -> Unit
) {
    var movies by remember { mutableStateOf(listOf<Movie>()) }
    var currentPage by remember { mutableStateOf(initialPage) }
    var isLoading by remember { mutableStateOf(false) }
    val scope = rememberCoroutineScope()
    val gridState = rememberLazyGridState()

    LaunchedEffect(currentPage) {
        if (currentPage != initialPage) {
            onMovieClick(null, currentPage)
        }
        isLoading = true
        scope.launch(Dispatchers.IO) {
            try {
                val url = if (currentPage == 1) "https://tamilgun.now/video-category/hd-movies/"
                else "https://tamilgun.now/video-category/hd-movies/page/$currentPage/"
                val doc = Jsoup.connect(url).get()
                val elements = doc.select("article.post-item")
                val scraped = elements.map {
                    Movie(
                        it.select("h3.entry-title a").text(),
                        it.select("img.blog-img").attr("src"),
                        it.select("h3.entry-title a").attr("href")
                    )
                }
                withContext(Dispatchers.Main) {
                    movies = scraped
                    isLoading = false
                }
            } catch (e: Exception) {
                isLoading = false
            }
        }
    }

    Column(modifier = Modifier.fillMaxSize()) {
        if (isLoading) {
            Box(modifier = Modifier.weight(1f).fillMaxWidth(), contentAlignment = Alignment.Center) {
                CircularProgressIndicator(color = Color.Yellow)
            }
        } else {
            LazyVerticalGrid(
                state = gridState,
                columns = GridCells.Fixed(4),
                contentPadding = PaddingValues(24.dp),
                modifier = Modifier.weight(1f)
            ) {
                itemsIndexed(movies) { index, movie ->
                    val focusRequester = remember { FocusRequester() }
                    LaunchedEffect(movies) {
                        if (initialSelectedMovie != null && movie.detailUrl == initialSelectedMovie.detailUrl) {
                            focusRequester.requestFocus()
                        } else if (initialSelectedMovie == null && index == 0) {
                            focusRequester.requestFocus()
                        }
                    }
                    MovieTile(
                        movie = movie,
                        modifier = Modifier.focusRequester(focusRequester),
                        onClick = { onMovieClick(movie, currentPage) }
                    )
                }
            }
        }
        Row(
            modifier = Modifier.fillMaxWidth().background(Color.Black.copy(alpha = 0.5f)).padding(16.dp),
            horizontalArrangement = Arrangement.Center,
            verticalAlignment = Alignment.CenterVertically
        ) {
            TvButton(label = "« Prev", enabled = currentPage > 1, modifier = Modifier.width(150.dp)) {
                currentPage--
            }
            Spacer(modifier = Modifier.width(32.dp))
            Text("Page $currentPage", color = Color.White, fontWeight = FontWeight.Bold)
            Spacer(modifier = Modifier.width(32.dp))
            TvButton(label = "Next »", modifier = Modifier.width(150.dp)) {
                currentPage++
            }
        }
    }
}

@Composable
fun MovieTile(movie: Movie, modifier: Modifier = Modifier, onClick: () -> Unit) {
    var isFocused by remember { mutableStateOf(false) }
    val scale by animateFloatAsState(if (isFocused) 1.1f else 1.0f, label = "scale")
    val borderColor by animateColorAsState(if (isFocused) Color.Yellow else Color.Transparent, label = "border")
    Column(
        modifier = modifier
            .padding(8.dp)
            .scale(scale)
            .onFocusChanged { isFocused = it.isFocused }
            .focusable()
            .clickable { onClick() },
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Box(modifier = Modifier
            .aspectRatio(16f / 9f)
            .clip(MaterialTheme.shapes.medium)
            .border(2.dp, borderColor, MaterialTheme.shapes.medium)
        ) {
            AsyncImage(
                model = movie.thumbUrl,
                contentDescription = null,
                contentScale = ContentScale.Crop,
                modifier = Modifier.fillMaxSize()
            )
        }
        Text(
            text = movie.title,
            color = if (isFocused) Color.Yellow else Color.White,
            maxLines = 1,
            modifier = Modifier.padding(top = 4.dp),
            fontWeight = if (isFocused) FontWeight.Bold else FontWeight.Normal
        )
    }
}

@Composable
fun TvButton(label: String, modifier: Modifier = Modifier, enabled: Boolean = true, onClick: () -> Unit) {
    var isFocused by remember { mutableStateOf(false) }
    val scale by animateFloatAsState(if (isFocused && enabled) 1.1f else 1.0f, label = "btnScale")
    Button(
        onClick = onClick,
        enabled = enabled,
        colors = ButtonDefaults.buttonColors(
            containerColor = if (isFocused) Color.Yellow else Color.Gray,
            contentColor = if (isFocused) Color.Black else Color.White,
            disabledContainerColor = Color.DarkGray
        ),
        modifier = modifier
            .onFocusChanged { isFocused = it.isFocused }
            .scale(scale)
            .focusable()
    ) {
        Text(label, fontWeight = FontWeight.Bold)
    }
}

@Composable
fun PlayerSelectionScreen(movie: Movie, onSourceSelected: (String) -> Unit) {
    var sources by remember { mutableStateOf(listOf<PlayerSource>()) }
    var isLoading by remember { mutableStateOf(true) }
    LaunchedEffect(movie) {
        withContext(Dispatchers.IO) {
            try {
                val doc = Jsoup.connect(movie.detailUrl).get()
                val videoContainers = doc.select(".video-container iframe")
                val scraped = videoContainers.mapIndexed { i, el ->
                    PlayerSource("Player ${i + 1}", el.attr("src"))
                }
                withContext(Dispatchers.Main) {
                    sources = scraped
                    isLoading = false
                }
            } catch (e: Exception) { isLoading = false }
        }
    }
    Column(modifier = Modifier.fillMaxSize(), verticalArrangement = Arrangement.Center, horizontalAlignment = Alignment.CenterHorizontally) {
        Text(movie.title, style = MaterialTheme.typography.headlineSmall, color = Color.White, modifier = Modifier.padding(bottom = 32.dp))
        if (isLoading) CircularProgressIndicator(color = Color.Yellow)
        else {
            sources.forEachIndexed { index, source ->
                val focusRequester = remember { FocusRequester() }
                LaunchedEffect(Unit) { if (index == 0) focusRequester.requestFocus() }
                TvButton(
                    label = source.name,
                    modifier = Modifier.width(220.dp).padding(8.dp).focusRequester(focusRequester)
                ) { onSourceSelected(source.url) }
            }
        }
    }
}

@Composable
fun FullScreenPlayer(videoUrl: String) {
    val finalUrl = if (videoUrl.startsWith("//")) "https:$videoUrl" else videoUrl

    AndroidView(
        modifier = Modifier.fillMaxSize().background(Color.Black).focusable(),
        factory = { context ->
            WebView(context).apply {
                layoutParams = ViewGroup.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.MATCH_PARENT
                )
                settings.javaScriptEnabled = true
                settings.domStorageEnabled = true
                settings.mediaPlaybackRequiresUserGesture = false
                settings.allowContentAccess = true
                settings.userAgentString = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36"

                isFocusable = true
                isFocusableInTouchMode = true

                webViewClient = object : WebViewClient() {
                    override fun onPageFinished(view: WebView?, url: String?) {
                        super.onPageFinished(view, url)

                        val script = """
                            (function() {
                                // 1. STYLES: Ghost the bad buttons and ads
                                var style = document.createElement('style');
                                style.innerHTML = `
                                    .scroll-top, #scroll-top, .back-to-top, [class*="scroll"], [id*="scroll"] {
                                        opacity: 0 !important;
                                        pointer-events: none !important;
                                        width: 1px !important;
                                        height: 1px !important;
                                        z-index: -9999 !important;
                                    }
                                    #over_player, .ads-class, .pop-under, [id^="ad_"] { display: none !important; }
                                `;
                                document.head.appendChild(style);

                                // 2. VISIBILITY SPOOF: Keep player active
                                Object.defineProperty(document, 'visibilityState', {get: function() { return 'visible'; }});
                                Object.defineProperty(document, 'hidden', {get: function() { return false; }});

                                // 3. FOCUS TELEPORT: Forward remote focus to the play button
                                function teleportFocus() {
                                    var active = document.activeElement;
                                    var badSelectors = '.scroll-top, #scroll-top, .back-to-top, [class*="scroll"]';
                                    if (active && active.matches(badSelectors)) {
                                        active.blur();
                                        var pBtn = document.querySelector('.vjs-big-play-button, .jw-display-icon-container, #play-btn, video');
                                        if (pBtn) pBtn.focus();
                                    }
                                }
                                document.addEventListener('focusin', teleportFocus);

                                // 4. SMART PLAY: Auto-play without blocking manual pause
                                var userClicked = false;
                                document.addEventListener('click', () => {
                                    userClicked = true;
                                    setTimeout(() => { userClicked = false; }, 3000);
                                });

                                var loadCounter = 0;
                                var itv = setInterval(() => {
                                    loadCounter++;
                                    var v = document.querySelector('video');
                                    if (v && v.paused && !userClicked && loadCounter < 15) {
                                        v.muted = false;
                                        v.play().catch(()=>{});
                                    }

                                    // Also click big play buttons if present
                                    if (loadCounter < 8) {
                                       var btn = document.querySelector('.vjs-big-play-button, .jw-display-icon-container, #play-btn');
                                       if (btn) btn.click();
                                    }
                                    teleportFocus();
                                }, 1500);

                                setTimeout(() => clearInterval(itv), 25000);
                            })();
                        """.trimIndent()
                        evaluateJavascript(script, null)

                        // Wake up player with simulated touch
                        postDelayed({
                            val x = width / 2f
                            val y = height / 2f
                            val t = android.os.SystemClock.uptimeMillis()
                            dispatchTouchEvent(android.view.MotionEvent.obtain(t, t, android.view.MotionEvent.ACTION_DOWN, x, y, 0))
                            dispatchTouchEvent(android.view.MotionEvent.obtain(android.os.SystemClock.uptimeMillis(), android.os.SystemClock.uptimeMillis(), android.view.MotionEvent.ACTION_UP, x, y, 0))
                        }, 4000)
                    }
                }

                webChromeClient = WebChromeClient()

                setOnKeyListener { v, keyCode, event ->
                    if (event.action == android.view.KeyEvent.ACTION_DOWN) {
                        if (keyCode == android.view.KeyEvent.KEYCODE_DPAD_CENTER || keyCode == android.view.KeyEvent.KEYCODE_ENTER) {
                            val x = v.width / 2f
                            val y = v.height / 2f
                            val time = android.os.SystemClock.uptimeMillis()
                            dispatchTouchEvent(android.view.MotionEvent.obtain(time, time, android.view.KeyEvent.ACTION_DOWN, x, y, 0))
                            dispatchTouchEvent(android.view.MotionEvent.obtain(android.os.SystemClock.uptimeMillis(), android.os.SystemClock.uptimeMillis(), android.view.KeyEvent.ACTION_UP, x, y, 0))
                            return@setOnKeyListener true
                        }
                    }
                    false
                }
                loadUrl(finalUrl, mapOf("Referer" to "https://tamilgun.now/"))
            }
        }
    )
}